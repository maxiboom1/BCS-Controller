{
  "name": "bcs-controller",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.ts",
    "start": "node server/index.ts",
    "admin": "node server/cli.ts admin",
    "backup": "node server/cli.ts backup",
    "build": "tsc --noEmit && vite build",
    "test": "node --test test/*.test.ts",
    "test:browser": "node --test test/browser.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^12.4.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.57.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
