{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "jsx": "react-jsx", "skipLibCheck": true, "esModuleInterop": true,
    "types": ["node", "vite/client"]
  },
  "include": ["server", "shared", "web", "test", "vite.config.ts"]
}
